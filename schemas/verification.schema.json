{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jyqj/jin-math-explore/schemas/verification.schema.json",
  "title": "Independent Mathematical Verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "verification_id", "problem_id", "claim_id", "candidate", "dependencies", "reviewer_principal", "context_isolated", "verdict", "checked_scope", "earliest_error", "unresolved", "cannot_imply"],
  "properties": {
    "schema": {"const": "jin-math-verification/v1"},
    "verification_id": {"type": "string"},
    "problem_id": {"type": "string"},
    "claim_id": {"type": "string"},
    "candidate": {"$ref": "#/$defs/pointer"},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/pointer"}},
    "reviewer_principal": {"type": "string", "minLength": 1},
    "context_isolated": {"const": true},
    "verdict": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
    "checked_scope": {"type": "string", "minLength": 1},
    "earliest_error": {"type": ["string", "null"]},
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "cannot_imply": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
