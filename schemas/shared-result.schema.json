{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jyqj/jin-math-explore/schemas/shared-result.schema.json",
  "title": "Cross-project Shared Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "shared_id", "kind", "source_project", "source_claim", "source_commit", "status", "statement", "assumptions", "scope", "evidence_refs", "cannot_imply"],
  "properties": {
    "schema": {"const": "jin-math-shared-result/v1"},
    "shared_id": {"type": "string", "pattern": "^S-[0-9]{4,}$"},
    "kind": {"enum": ["shared_lemma", "shared_method", "shared_computation", "shared_obstruction"]},
    "source_project": {"type": "string", "pattern": "^P-[0-9]{4,}$"},
    "source_claim": {"type": "string"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"const": "independently_verified"},
    "statement": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "scope": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1},
    "cannot_imply": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
