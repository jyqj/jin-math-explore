{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jyqj/jin-math-explore/schemas/project-registry.schema.json",
  "title": "Jin Math Project Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "slug", "title", "problem_class", "operational_status", "mathematical_status", "project_path", "objective_sha256", "current_window_id", "dependencies", "source_audit", "last_merged_window"],
  "properties": {
    "schema": {"const": "jin-math-project-registry/v1"},
    "project_id": {"type": "string", "pattern": "^P-[0-9]{4,}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "problem_class": {"enum": ["known_open", "likely_open_needs_audit", "internal_frontier", "missing_lemma", "computational_conjecture", "generalization", "optimality_question", "counterexample_search"]},
    "operational_status": {"enum": ["candidate", "source_audit", "objective_freeze", "active", "review_gate", "compute_wait", "parked", "terminal_audit", "closed"]},
    "mathematical_status": {"enum": ["unknown", "open", "partial", "proof_candidate", "refuted", "complete"]},
    "project_path": {"type": ["string", "null"]},
    "objective_sha256": {"type": ["string", "null"]},
    "current_window_id": {"type": ["string", "null"]},
    "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^P-[0-9]{4,}$"}, "uniqueItems": true},
    "source_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "as_of", "receipt"],
      "properties": {
        "status": {"enum": ["pending", "pass", "fail", "stale"]},
        "as_of": {"type": ["string", "null"], "format": "date"},
        "receipt": {"type": ["string", "null"]}
      }
    },
    "last_merged_window": {"type": ["string", "null"]}
  }
}
