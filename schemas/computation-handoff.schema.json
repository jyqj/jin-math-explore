{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jyqj/jin-math-explore/schemas/computation-handoff.schema.json",
  "title": "Research Computation Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "problem_id", "window_id", "attempt_id", "claim_id", "objective_sha256", "question", "domain", "assumptions", "requested_evidence", "backend", "exact_input", "reproduction_command", "code_artifacts", "result_artifacts", "computation_record", "evidence_grade", "cannot_imply"],
  "properties": {
    "schema": {"const": "jin-math-computation-handoff/v1"},
    "problem_id": {"type": "string"},
    "window_id": {"type": "string"},
    "attempt_id": {"type": "string"},
    "claim_id": {"type": ["string", "null"]},
    "objective_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "question": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "requested_evidence": {"enum": ["numerical_evidence", "bounded_check", "exact_check", "proof_certificate", "formal_verification"]},
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "interface", "inventory_snapshot_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "interface": {"type": "string", "minLength": 1},
        "inventory_snapshot_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "exact_input": {},
    "reproduction_command": {"type": "string", "minLength": 1},
    "code_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pointer"}},
    "result_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pointer"}},
    "computation_record": {"$ref": "#/$defs/pointer"},
    "evidence_grade": {"enum": ["numerical_evidence", "bounded_check", "exact_check", "proof_certificate", "formal_verification"]},
    "cannot_imply": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
