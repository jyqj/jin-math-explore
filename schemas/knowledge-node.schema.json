{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jyqj/jin-math-explore/schemas/knowledge-node.schema.json",
  "title": "Jin Math Knowledge Node",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "knowledge_id",
    "kind",
    "title",
    "classification",
    "statement",
    "assumptions",
    "scope",
    "conventions",
    "prerequisites",
    "relations",
    "authority",
    "source_refs",
    "cannot_imply"
  ],
  "properties": {
    "schema": {
      "const": "jin-math-knowledge-node/v1"
    },
    "knowledge_id": {
      "type": "string",
      "pattern": "^K-[0-9]{4,}$"
    },
    "kind": {
      "enum": [
        "definition",
        "notation",
        "theorem",
        "lemma",
        "equivalence",
        "method",
        "example",
        "counterexample",
        "obstruction",
        "computational_fact",
        "reference_map",
        "knowledge_gap"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "$ref": "#/$defs/knowledgeClassification"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "conventions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^K-[0-9]{4,}$"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cannot_imply": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "mscCode": {
      "type": "string",
      "pattern": "^[0-9]{2}(?:-[0-9]{2}|-XX|[A-Z](?:[0-9]{2}|xx)?)?$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "primary",
        "secondary"
      ],
      "properties": {
        "scheme": {
          "const": "MSC2020"
        },
        "primary": {
          "anyOf": [
            {
              "const": "unclassified"
            },
            {
              "$ref": "#/$defs/mscCode"
            }
          ]
        },
        "secondary": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/mscCode"
          }
        }
      }
    },
    "knowledgeClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "object_tags",
        "method_tags"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "object_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tag"
          }
        },
        "method_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tag"
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "enum": [
            "generalizes",
            "specializes",
            "equivalent_to",
            "contrasts_with",
            "uses_method",
            "applies_to",
            "motivates",
            "obstructs",
            "discharges"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^(?:K|P|S)-[0-9]{4,}$"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "receipt",
        "shared_result"
      ],
      "properties": {
        "status": {
          "enum": [
            "reference_only",
            "source_audited",
            "independently_verified"
          ]
        },
        "receipt": {
          "type": [
            "string",
            "null"
          ]
        },
        "shared_result": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^S-[0-9]{4,}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
